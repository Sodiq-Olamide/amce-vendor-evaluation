# ==============================================================================
# AMCE Vendor Evaluation Management System (VEMS) - Environment Variables Template
# Copy this file to .env and populate with your environment-specific values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=vems.amce.ng,vems.amce.local,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://vems.amce.ng,http://127.0.0.1:8000
SITE_DOMAIN=https://vems.amce.ng

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Leave empty to use local SQLite (db.sqlite3), or provide a PostgreSQL connection URI:
# DATABASE_URL=postgresql://amce_user:StrongPassword@127.0.0.1:5432/amce_vems_db

# ------------------------------------------------------------------------------
# 3. OUTBOUND EMAIL GATEWAY (MICROSOFT 365 / EXCHANGE / SMTP)
# ------------------------------------------------------------------------------
# Use django.core.mail.backends.console.EmailBackend for local testing without sending real emails.
# Use django.core.mail.backends.smtp.EmailBackend for live delivery.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@amce.ng
EMAIL_HOST_PASSWORD=YourSecureMailOrAppPasswordHere
DEFAULT_FROM_EMAIL="AMCE Evaluation Committee <notifications@amce.ng>"

# ------------------------------------------------------------------------------
# 4. ACTIVE DIRECTORY / LDAP INTEGRATION (OPTIONAL / ON-PREMISES)
# ------------------------------------------------------------------------------
LDAP_SERVER_URI=ldaps://dc01.amce.local:636
LDAP_BIND_DN=CN=svc_vems,OU=ServiceAccounts,DC=amce,DC=local
LDAP_BIND_PASSWORD=ServiceAccountPasswordHere
LDAP_SEARCH_BASE=OU=HospitalStaff,DC=amce,DC=local
